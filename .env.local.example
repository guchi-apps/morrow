# ローカル開発用。`pnpm env:init` で .env.local としてコピーしてから編集する。
# .env.local はgit管理外。実シークレットはここと1Passwordにのみ置く。

# ローカルのMariaDB/MySQL。pnpm db:setup がこのURLからDB・ユーザーを作成する
DATABASE_URL="mysql://aide_bot:aide_bot@127.0.0.1:3306/app_aide_bot"

# Supabase Auth（他アプリと共有のSupabaseプロジェクト。1Password: apps/Supabase）
# Redirect URLs に http://localhost:3000/auth/callback の登録が必要。
#
# 既定はCIと同じダミー値。**空文字にしないこと**——middleware（src/lib/supabase/middleware.ts）が
# `Your project's URL and Key are required` を投げ、開発用ログインを含む全リクエストが500になる
# （#121でworktreeごとに踏んでいた）。ダミーのままでも「開発用ダミーユーザーでログイン」からは
# 入れるので、Googleでの実ログインを試すときだけ実際の値へ差し替える。
NEXT_PUBLIC_SUPABASE_URL="https://ci-placeholder.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="ci-placeholder"

# 自分のGoogleアカウントのメールアドレス（カンマ区切りで複数可）
ALLOWED_GOOGLE_EMAILS=""

# 秘書からのプロアクティブ通知（#79）。Web PushのVAPID鍵のペア。
# **手元で使う鍵は自分で作る**（1Passwordの本番の鍵は持ち出さない）。
#   node -e 'console.log(JSON.stringify(require("web-push").generateVAPIDKeys()))'
# 片方でも空だと、設定の画面に通知の導線そのものが出ない。
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_KEY_P8=""

# cronが POST /api/briefing を叩くときの共有シークレット。空ならこの経路は401で閉じる。
# 手元で定時のお知らせを試すときだけ、適当な値を入れて curl の Bearer に同じ値を使う。
BRIEFING_TRIGGER_TOKEN=""

# ops-dashboardが GET /api/ai-usage でアプリ別のAI利用（#297）を読みにくるときのBearer。
# ops-dashboardの `OPS_API_TOKEN` と同じ値。空ならこの経路は401で閉じる。手元で試すときだけ、
# 適当な値を入れて curl の Bearer に同じ値を使う（本番の値は持ち出さない）。
OPS_API_TOKEN=""

# Notionの「Task」DBを直接管理する /api/tasks とタスクのMCPツール（#373）のインテグレーショントークン。
# 空なら503で閉じる。Task DBの共有が要る。データソースIDを変えるときだけ NOTION_TASK_DATA_SOURCE_ID。
NOTION_API_TOKEN=""
# タスクのMCPツール（/api/mcp の aide_task_*）を呼ぶBearer。空なら閉じる。
TASK_API_TOKEN=""

# ChatGPTのスケジュールから接続するMCPエンドポイントは /api/mcp

# 開発サーバーのポート（省略時は3000）
# PORT=3000

# 返答の生成をCodexではなく固定の返答を返すスタブに差し替える（#205）。音声の往復を
# 何度も試すときに使う。**コマンドラインで前置きしても効かない**のでここへ書く。
# CODEX_BIN="./scripts/codex-stub.sh"

# 開発用ログイン（Cookieバイパス）のシークレット。設定されている開発環境でのみ、
# ログイン画面に「開発用ダミーユーザーでログイン」ボタンが出る。
# `pnpm db:seed:dev` が未設定なら自動生成して書き足すので、通常は手で書かなくてよい。
# **本番には絶対に設定しない**（NODE_ENV=production では無効化されるが、二重に塞ぐため）。
# CI_LOGIN_BYPASS_SECRET=""

# issue-deckの共有トークンAPI（#403）。両方あれば OPS_API_TOKEN を共有トークンから取り、無ければ上の環境変数を使う
SHARED_TOKEN_API_SECRET=""
ISSUE_DECK_URL=""
